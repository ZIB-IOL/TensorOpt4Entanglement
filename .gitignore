.julia_depot/
# patched copy of the MOSEK libraries (scripts/fix_execstack.py) -- machine
# specific and ~50 MiB. Both forms: a trailing slash matches directories only,
# and a symlink of the same name would otherwise slip through.
.mosek_bin
.mosek_bin/
outputs/
__pycache__/
*.pyc
results/*/logs/
joblists/


# A/B comparison output (scripts/ab)
ab/

# generated by scripts/make_figures.py and scripts/make_tables.py --out;
# regenerable from results/, and the .dat files run to ~130 MB
plots/
tables/
